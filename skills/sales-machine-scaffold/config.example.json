{
  "product": {
    "name": "<ProductName>",
    "tagline": "<one-line promise>",
    "category": "<what it is in 3 words>"
  },
  "language": {
    "content": "en",
    "team": "en",
    "secondaryContent": []
  },
  "sources": {
    "code": ["<local folder>"],
    "docs": ["<local folder or file>"],
    "releaseNotes": ["<local file>"],
    "featureFlags": ["<local file listing flags and rollout state>"],
    "notes": ["<any other local file>"]
  },
  "access": {
    "mode": "invite-only | open | waitlist",
    "primaryCta": "Request access",
    "secondaryCta": "Talk to our team",
    "forbiddenCtas": ["Create your account", "Sign up free"]
  },
  "flagship": {
    "who": "<the customer the home page talks to first>",
    "pain": "<what they lose today>"
  },
  "lanes": [
    {
      "id": "self-serve",
      "label": "On their own",
      "buyingSignal": "<e.g. N uses in 30 days>"
    },
    {
      "id": "assisted",
      "label": "With the team",
      "buyingSignal": "<e.g. any purchase milestone>"
    }
  ],
  "personas": [
    {
      "id": "<slug>",
      "name": "<Persona>",
      "wants": "<job to be done>",
      "lane": "self-serve | assisted"
    }
  ],
  "integrations": [
    {
      "slug": "<provider-slug>",
      "name": "<Provider>",
      "kind": "<category>",
      "live": true
    }
  ],
  "loops": ["integrations", "invites", "content"],
  "neverSay": [
    "<prices, plans, limits, free, trial>",
    "<customer names>",
    "<unreleased features as live>"
  ],
  "sayInstead": {
    "<word to avoid>": "<word to use>"
  },
  "internalOnly": ["<revenue levers>", "<internal metrics>"],
  "regulatedTopics": [
    {
      "topic": "<e.g. identity checks>",
      "rule": "<the only true statement we make about it>"
    }
  ],
  "batch": {
    "articlesPerRun": 3,
    "minSalesLane": 2
  }
}
